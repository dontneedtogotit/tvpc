[Unit]
Description=Set HDMI audio profile for NUC7i5BNH (Broadwell)
After=pipewire.service pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=oneshot
ExecStart=/usr/bin/pactl set-card-profile alsa_card.pci-0000_00_1f.3 output:hdmi-stereo-extra
ExecStart=/usr/bin/pactl set-default-sink alsa_output.pci-0000_00_1f.3.hdmi-stereo-extra
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target